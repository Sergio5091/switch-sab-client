# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:root@localhost:5433/switchsab_app

# ─── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_with_a_strong_secret

# ─── Licence ────────────────────────────────────────────────────────────────
LICENCE_PUBLIC_KEY_PATH=./keys/public-key.pem

# ─── Switch (dev) ───────────────────────────────────────────────────────────
USE_MOCK_SWITCH=true   # true = simulateur, false = driver réel (USB ou WIFI)

# ─── Twilio (Phase 2.8) ─────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
