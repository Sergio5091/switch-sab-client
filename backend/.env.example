# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:root@localhost:5433/switchsab_app

# ─── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_with_a_strong_secret

# ─── Licence ────────────────────────────────────────────────────────────────
LICENCE_PUBLIC_KEY_PATH=./keys/public-key.pem

# ─── Switch (dev) ───────────────────────────────────────────────────────────
USE_MOCK_SWITCH=true   # true = simulateur, false = driver réel (ZIGBEE/USB/WIFI)

# ─── Zigbee / MQTT (Pi physique uniquement) ──────────────────────────────────
# Broker MQTT local — Mosquitto tourne sur le Pi
MQTT_URL=mqtt://localhost:1883
# Topic de base Zigbee2MQTT (ne pas changer sauf config Z2M personnalisée)
ZIGBEE2MQTT_TOPIC=zigbee2mqtt

# ─── Twilio (Phase 2.8) ─────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Exemples : Gmail, Mailtrap, OVH, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM="Switch SAB <votre.email@gmail.com>"

# ─── Rapport automatique ─────────────────────────────────────────────────────
# Heure d'envoi du rapport veille (cron, défaut = 07:00 chaque jour)
RAPPORT_CRON=0 7 * * *
# Fuseau horaire
TZ=Africa/Porto-Novo
