generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  CLIENT
  GERANT
  ADMIN
}

enum StatutSession {
  ACTIVE
  ARRETEE
  TERMINEE
}

enum StatutPoste {
  LIBRE
  OCCUPE
}

enum TypeTransaction {
  RECHARGE_GERANT
  RECHARGE_CLIENT
  RECHARGE_COUPON
  SESSION
  BONUS
}

// ─────────────────────────────────────────────
// Modèles
// ─────────────────────────────────────────────

model Salle {
  id           Int      @id @default(autoincrement())
  nom          String
  pays         String
  ville        String
  quartier     String
  telephone    String
  email        String?                    // Email du propriétaire pour les rapports
  disabled     Boolean  @default(false)
  switchType   String   @default("MOCK") // "MOCK", "ZIGBEE", "USB", "WIFI"
  switchConfig String?                   // IP ou port COM
  indicatifPays String  @default("BJ")   // Code ISO pays pour normalisation tél (ex: BJ, SN, FR, US)
  dernierExportContacts DateTime?        // date du dernier export .vcf pour détection nouveaux clients
  createdAt    DateTime @default(now())

  users       User[]
  categories  Categorie[]
  promos      Promo[]
  configBonus ConfigBonus?
  coupons     Coupon[]
}

model User {
  id           Int      @id @default(autoincrement())
  pseudo       String   @unique
  email        String?  @unique
  nom          String?
  prenom       String?
  telephone    String   @unique
  motDePasse   String
  role         Role     @default(CLIENT)
  estEnfant    Boolean  @default(false)
  codeParental String?
  telUrgence   String?  // pour les gérants
  salleId      Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  salle          Salle?        @relation(fields: [salleId], references: [id])
  sessions       Session[]     @relation("ClientSessions")
  sessionsGerant Session[]     @relation("GerantSessions")
  credits        Credit[]
  transactions   Transaction[]
  bonus          Bonus?
  promoCode      PromoCode?
  solde          Float         @default(0)  // Solde monétaire FCFA — alimenté uniquement par coupons
}

model Categorie {
  id      Int    @id @default(autoincrement())
  nom     String // "PS4", "PS5", "XBOX"
  salleId Int

  salle   Salle    @relation(fields: [salleId], references: [id])
  durees  Duree[]
  postes  Poste[]
  credits Credit[]
}

model Duree {
  id          Int    @id @default(autoincrement())
  libelle     String // "30min", "1H", "2H"
  secondes    Int    // durée en secondes
  prix        Float
  categorieId Int

  categorie             Categorie              @relation(fields: [categorieId], references: [id])
  sessions              Session[]
}

model Poste {
  id          Int         @id @default(autoincrement())
  nom         String
  image       String?     // URL image personnalisée
  statut      StatutPoste @default(LIBRE)
  categorieId Int
  zigbeeName  String?     // friendly_name généré automatiquement lors de l'appairage (ex: "ps4_1")

  categorie Categorie @relation(fields: [categorieId], references: [id])
  sessions  Session[]
}

model Session {
  id           Int           @id @default(autoincrement())
  clientId     Int
  gerantId     Int
  posteId      Int
  dureeId      Int
  debut        DateTime      @default(now())
  fin          DateTime?
  tempsRestant Int           // en secondes
  statut       StatutSession @default(ACTIVE)
  estBonus     Boolean       @default(false)
  createdAt    DateTime      @default(now())

  client User  @relation("ClientSessions", fields: [clientId], references: [id])
  gerant User  @relation("GerantSessions", fields: [gerantId], references: [id])
  poste  Poste @relation(fields: [posteId], references: [id])
  duree  Duree @relation(fields: [dureeId], references: [id])
}

model Credit {
  id          Int @id @default(autoincrement())
  clientId    Int
  categorieId Int
  solde       Int @default(0) // en secondes

  client    User      @relation(fields: [clientId], references: [id])
  categorie Categorie @relation(fields: [categorieId], references: [id])

  @@unique([clientId, categorieId])
}

model Transaction {
  id       Int             @id @default(autoincrement())
  clientId Int
  montant  Float
  type     TypeTransaction
  date     DateTime        @default(now())
  gerantId Int?

  client User @relation(fields: [clientId], references: [id])
}

model Coupon {
  id        Int      @id @default(autoincrement())
  code      String   @unique // alphanumérique sans O ni 0, format XXXX-XXXX
  valeur    Float
  utilise   Boolean  @default(false)
  salleId   Int
  createdAt DateTime @default(now())

  salle Salle @relation(fields: [salleId], references: [id])
}

model Bonus {
  id               Int      @id @default(autoincrement())
  clientId         Int      @unique
  solde            Int      @default(0)     // en secondes
  disponible       Boolean  @default(false)
  derniereActivite DateTime @default(now())

  client User @relation(fields: [clientId], references: [id])
}

model ConfigBonus {
  id              Int   @id @default(autoincrement())
  salleId         Int   @unique              // une config par salle
  ratioSecondes   Int                        // secondes bonus / heure jouée
  seuilDeblocage  Int                        // secondes pour débloquer
  validitejours   Int   @default(30)
  reductionInvite Float @default(0)          // % réduction client invité
  bonusParrain    Float @default(0)          // montant FCFA offert au parrain lors d'un parrainage
  bonusFilleul    Float @default(0)          // montant FCFA offert au filleul à son inscription

  salle Salle @relation(fields: [salleId], references: [id])
}

model PromoCode {
  id           Int      @id @default(autoincrement())
  clientId     Int      @unique
  code         String   @unique
  utilisations Int      @default(0)
  createdAt    DateTime @default(now())

  client User @relation(fields: [clientId], references: [id])
}

model Promo {
  id        Int      @id @default(autoincrement())
  titre     String
  message   String?
  image     String?
  salleId   Int
  createdAt DateTime @default(now())
  envoyee   Boolean  @default(false)

  salle Salle @relation(fields: [salleId], references: [id])
}

// Licence locale — copie de la licence générée par le Projet 1
// Vérifiée hors-ligne avec la clé publique RSA
// salleId est un identifiant de référence Super Admin, sans FK locale
model LicenceLocale {
  id        Int      @id @default(autoincrement())
  licenceId String   @unique
  salleId   Int      // référence Super Admin — pas de FK sur Salle
  machineId String
  issuedAt  DateTime
  expiresAt DateTime
  status    String   @default("ACTIVE")
  signature String
  hash      String   // Hash de contrôle anti-fraude
  createdAt DateTime @default(now())
}
